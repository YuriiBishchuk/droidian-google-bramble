# Reference: <https://postmarketos.org/devicepkg>
maintainer="Yurii Bishchuk <astellias@gmail.com>"
pkgname=device-google-bramble
pkgver=1
pkgrel=9
pkgdesc="Google Pixel 4a (5G) (SM7250 / Snapdragon 765G)"
url="https://wiki.postmarketos.org/wiki/Google_Pixel_4a_(5G)_(google-bramble)"
arch="aarch64"
license="MIT"
depends="
	android-tools
	linux-google-bramble
	postmarketos-base
	postmarketos-base-downstream
	seatd
	libdrm
	"
makedepends="
	devicepkg-dev
	libdrm-dev
	gcc
	"
source="
	deviceinfo
	modules-initfs
	lito-v2.dtb
	initfs-hook.sh
	fix_drm_formats.c
	90-google-bramble.rules
	bramble-display.sh
	phoc.ini
	start_gui.sh
	"
options="!archcheck !check"
subpackages="$pkgname-udev"

build() {
	devicepkg_build "$startdir" "$pkgname"
	${CC:-gcc} -O2 -fPIC -shared -I/usr/include/libdrm \
		"$srcdir"/fix_drm_formats.c -o libfix_drm_formats.so -ldrm -ldl
}

package() {
	devicepkg_package "$startdir" "$pkgname"

	# Device Tree
	install -Dm644 "$srcdir"/lito-v2.dtb "$pkgdir"/usr/share/dtb/lito-v2.dtb

	# Qualcomm MSM DRM fix (FourCC duplicate assert, monotonic clock, udev touch, faccessat)
	install -Dm755 libfix_drm_formats.so "$pkgdir"/usr/lib/libfix_drm_formats.so

	# Udev rules for touchscreen & display
	install -Dm644 "$srcdir"/90-google-bramble.rules "$pkgdir"/usr/lib/udev/rules.d/90-google-bramble.rules

	# Global environment profile
	install -Dm755 "$srcdir"/bramble-display.sh "$pkgdir"/etc/profile.d/bramble-display.sh

	# Phosh display scaling & config
	install -Dm644 "$srcdir"/phoc.ini "$pkgdir"/etc/phosh/phoc.ini

	# Interactive mobile GUI launcher
	install -Dm755 "$srcdir"/start_gui.sh "$pkgdir"/usr/bin/start_gui.sh
}
